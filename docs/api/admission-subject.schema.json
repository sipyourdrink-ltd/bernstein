{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed benchmark admission subject v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_ref", "task_classes"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_requested"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "pattern": "^[^/\\s](?:[^/]*[^/\\s])?$", "allOf": [{"not": {"type": "string", "pattern": "@"}}]},
        "model_requested": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$", "allOf": [{"not": {"type": "string", "pattern": "@"}}]},
        "model_reported": {"type": ["string", "null"], "minLength": 1, "pattern": "^\\S(?:.*\\S)?$", "allOf": [{"not": {"type": "string", "pattern": "@"}}]},
        "version": {"type": ["string", "null"], "minLength": 1, "pattern": "^\\S(?:.*\\S)?$", "allOf": [{"not": {"type": "string", "pattern": "@"}}, {"not": {"const": "*"}}]},
        "routing_decision_hash": {"type": "string", "pattern": "^(sha256:.*)?$"}
      }
    },
    "task_classes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
    }
  }
}
