[76.173762, "o", "\u001b[32m\u2713\u001b[0m Orchestration finished\r\n\r\n\u001b[1;36m\u2500\u2500 Demo Summary \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
[76.176997, "o", "\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1;35m \u001b[0m\u001b[1;35mMetric      \u001b[0m\u001b[1;35m \u001b[0m\u2503\u001b[1;35m \u001b[0m\u001b[1;35m  Value\u001b[0m\u001b[1;35m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[1m \u001b[0m\u001b[1mBugs fixed  \u001b[0m\u001b[1m \u001b[0m\u2502   \u001b[32m4\u001b[0m / 4 \u2502\r\n\u2502\u001b[1m \u001b[0m\u001b[1mElapsed     \u001b[0m\u001b[1m \u001b[0m\u2502     66s \u2502\r\n\u2502\u001b[1m \u001b[0m\u001b[1mPython files\u001b[0m\u001b[1m \u001b[0m\u2502       3 \u2502\r\n\u2502\u001b[1m \u001b[0m\u001b[1mAPI cost    \u001b[0m\u001b[1m \u001b[0m\u2502 $0.0000 \u2502\r\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
[76.177507, "o", "\r\n\u001b[2mEvery agent decision was logged. Run \u001b[0m\u001b[1;2mbernstein audit verify --merkle-only\u001b[0m\u001b[2m to inspect the audit \u001b[0m\r\n\u001b[2mtrail.\u001b[0m\r\n"]
[76.177896, "o", "\r\n\u001b[1;32mFixed \u001b[0m\u001b[1;32m4\u001b[0m\u001b[1;32m bugs in 66s.\u001b[0m\r\n"]
[76.178253, "o", "Run \u001b[1;36mbernstein run\u001b[0m in your own project to get started.\r\n\r\n"]
[76.178574, "o", "\u001b[2mProject left at:\u001b[0m \u001b[35m/work/tmp/\u001b[0m\u001b[95mbernstein-demo-41rol0ut\u001b[0m\r\n"]
[76.180607, "o", "\u001b[2m  cd \u001b[0m\u001b[1;2m<\u001b[0m\u001b[1;2;95mdir\u001b[0m\u001b[1;2m>\u001b[0m\u001b[2m && pip install -r requirements.txt && pytest tests/ -q\u001b[0m\r\n"]
[76.886117, "o", "$ bernstein verify receipt docs/assets/demo-run/run-receipt.json \\\r\n    --public-key docs/assets/demo-run/run-receipt.pub.pem\r\n"]
[81.383576, "o", "\r\n"]
[81.388064, "o", "\u001b[1mRun receipt\u001b[0m \u001b[33mrun\u001b[0m=\u001b[1;36m20260830\u001b[0m-\u001b[1;36m061434\u001b[0m \u001b[33mjournal_events\u001b[0m=\u001b[1;36m32\u001b[0m \u001b[33mspine_entries\u001b[0m=\u001b[1;36m1\u001b[0m\r\n"]
[81.388983, "o", "\u001b[32mOK \u001b[0m\u001b[1;32m(\u001b[0m\u001b[32mprovenance: pinned key\u001b[0m\u001b[1;32m)\u001b[0m -- every head recomputes from the embedded ranges and the signature \r\nverifies against the pinned public key.\r\n"]
