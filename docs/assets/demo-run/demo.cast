[56.750046, "o", "\r\n\u001b[1;36m\u2500\u2500 Demo Summary \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
[56.754192, "o", "\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1;35m \u001b[0m\u001b[1;35mMetric      \u001b[0m\u001b[1;35m \u001b[0m\u2503\u001b[1;35m \u001b[0m\u001b[1;35m  Value\u001b[0m\u001b[1;35m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[1m \u001b[0m\u001b[1mBugs fixed  \u001b[0m\u001b[1m \u001b[0m\u2502   \u001b[32m4\u001b[0m / 4 \u2502\r\n\u2502\u001b[1m \u001b[0m\u001b[1mElapsed     \u001b[0m\u001b[1m \u001b[0m\u2502     54s \u2502\r\n\u2502\u001b[1m \u001b[0m\u001b[1mPython files\u001b[0m\u001b[1m \u001b[0m\u2502       3 \u2502\r\n\u2502\u001b[1m \u001b[0m\u001b[1mAPI cost    \u001b[0m\u001b[1m \u001b[0m\u2502 $0.0000 \u2502\r\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
[56.754747, "o", "\r\n\u001b[2mEvery agent decision was logged. Run \u001b[0m\u001b[1;2mbernstein audit verify --merkle-only\u001b[0m\u001b[2m to inspect the audit \u001b[0m\r\n\u001b[2mtrail.\u001b[0m\r\n"]
[56.755116, "o", "\r\n\u001b[1;32mFixed \u001b[0m\u001b[1;32m4\u001b[0m\u001b[1;32m bugs in 54s.\u001b[0m\r\n"]
[56.755512, "o", "Run \u001b[1;36mbernstein run\u001b[0m in your own project to get started.\r\n\r\n"]
[56.755814, "o", "\u001b[2mProject left at:\u001b[0m \u001b[35m/tmp/\u001b[0m\u001b[95mbernstein-demo-3rrdzih8\u001b[0m\r\n"]
[56.756126, "o", "\u001b[2m  cd \u001b[0m\u001b[1;2m<\u001b[0m\u001b[1;2;95mdir\u001b[0m\u001b[1;2m>\u001b[0m\u001b[2m && pip install -r requirements.txt && pytest tests/ -q\u001b[0m\r\n"]
[57.465844000000004, "o", "$ bernstein verify receipt docs/assets/demo-run/run-receipt.json \\\r\n    --public-key docs/assets/demo-run/run-receipt.pub.pem\r\n"]
[60.529098000000005, "o", "\r\n"]
[60.532077, "o", "\u001b[1mRun receipt\u001b[0m \u001b[33mrun\u001b[0m=\u001b[1;36m20260805\u001b[0m-\u001b[1;36m203706\u001b[0m \u001b[33mjournal_events\u001b[0m=\u001b[1;36m26\u001b[0m \u001b[33mspine_entries\u001b[0m=\u001b[1;36m0\u001b[0m\r\n"]
[60.532611, "o", "\u001b[32mOK \u001b[0m\u001b[1;32m(\u001b[0m\u001b[32mprovenance: pinned key\u001b[0m\u001b[1;32m)\u001b[0m -- every head recomputes from the embedded ranges and the signature \r\nverifies against the pinned public key.\r\n"]
