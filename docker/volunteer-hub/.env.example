# Volunteer hub environment template.
#
#   cp docker/volunteer-hub/.env.example docker/volunteer-hub/.env
#
# Fill in the values below, then bring the stack up:
#
#   docker compose -f docker/volunteer-hub/docker-compose.yaml \
#     --env-file docker/volunteer-hub/.env up -d
#
# The real .env is git-ignored. Never commit filled-in keys.

# Public hostname Caddy serves and requests a certificate for. Point its DNS
# A/AAAA record at this server before starting the stack, or the ACME
# challenge fails and no certificate is issued.
HUB_DOMAIN=hub.example.org

# Shared secret for the task API. Required: with it empty the server accepts
# unauthenticated writes from anything that reaches it on the internal
# network. Generate one with `openssl rand -hex 32`.
BERNSTEIN_AUTH_TOKEN=

# Model provider credentials. Set the ones the agents you run actually use;
# leaving a key empty disables that provider rather than failing the start.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
