{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bernstein_subscribe",
  "description": "Wait for one future role task notification over authenticated SSE, then unsubscribe. Host effects: makes network requests.",
  "timeoutSeconds": 65,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role"
  ],
  "properties": {
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 60,
      "default": 30
    }
  }
}
