{
  "name": "Bernstein",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "UV_PYTHON": "3.13"
  },
  "postCreateCommand": "uv sync --locked --group dev && uv run --locked bernstein --help",
  "remoteEnv": {
    "BERNSTEIN_REMOTE_QUICKSTART": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "forwardPorts": [8052]
}
