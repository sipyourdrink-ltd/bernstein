{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.0.0",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "bernstein-test-token",
              "shortDescription": {
                "text": "Bernstein synthetic test token"
              }
            }
          ]
        }
      },
      "results": [
        {
          "message": {
            "text": "bernstein-test-token has detected secret for file app.env."
          },
          "ruleId": "bernstein-test-token",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.env"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 12,
                  "endLine": 1,
                  "endColumn": 53,
                  "snippet": {
                    "text": "bernstein_test_secret_abcdefghijklmnopqrst"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "commitSha": "",
            "email": "",
            "author": "",
            "date": "",
            "commitMessage": ""
          },
          "properties": {
            "tags": []
          }
        }
      ]
    }
  ]
}
